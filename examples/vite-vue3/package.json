{
  "name": "vite-vue3-example",
  "type": "module",
  "private": true,
  "description": "unplugin-icons + Vue3 (Vite)",
  "scripts": {
    "dev": "DEBUG='unplugin-icons:*' vite",
    "build": "vite build"
  },
