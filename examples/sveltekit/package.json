{
  "name": "sveltekit-example",
  "type": "module",
  "private": true,
  "description": "unplugin-icons + SvelteKit",
  "scripts": {
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "dev": "vite dev",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@iconify-json/icon-park": "catalog:iconify",
    "@iconify-json/logos": "catalog:iconify",
    "@iconify-json/mdi": "catalog:iconify",
    "@sveltejs/kit": "catalog:svelte",
    "@sveltejs/vite-plugin-svelte": "catalog:svelte",
    "svelte": "catalog:svelte",
    "svelte-check": "catalog:svelte",
    "tslib": "catalog:svelte",
    "typescript": "catalog:build",
    "unplugin-icons": "workspace:*"
  },
  "stackblitz": {
    "installDependencies": false,
    "startCommand": "node .stackblitz.js && npm install && npm run dev"
  }
}
