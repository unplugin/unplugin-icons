{
  "name": "vite-qwik-example",
  "type": "module",
  "private": true,
  "description": "unplugin-icons + Qwik (Vite)",
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.types": "tsc --incremental --noEmit",
    "dev": "vite --mode ssr",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "start": "vite --open --mode ssr",
    "qwik": "qwik"
  },
  "devDependencies": {
    "@builder.io/qwik": "catalog:qwik",
    "@svgx/core": "catalog:build",
    "@types/eslint": "catalog:qwik",
    "@types/node": "catalog:build",
    "@types/node-fetch": "catalog:qwik",
    "@typescript-eslint/eslint-plugin": "catalog:qwik",
    "@typescript-eslint/parser": "catalog:qwik",
    "eslint": "catalog:qwik",
    "eslint-plugin-qwik": "catalog:qwik",
    "node-fetch": "catalog:qwik",
    "prettier": "catalog:qwik",
    "typescript": "catalog:qwik",
    "undici": "catalog:qwik",
    "unplugin-icons": "workspace:*",
    "vite": "catalog:qwik",
    "vite-tsconfig-paths": "catalog:qwik"
  },
  "stackblitz": {
    "installDependencies": false,
    "startCommand": "node .stackblitz.js && npm install && npm run dev"
  }
}
